# SO101 本机配置模板 —— 新机器先复制一份：cp station.env.example station.env，再按本机改
# station.env 不进 git（每台机器各一份）；任务文本 TASK 等需要各机一致的值，改了记得同步改这个模板
#
# SO101 本机配置 —— 换机器只改这一个文件
#
# 每台机器（数采机 / 推理机 / 别人的电脑）各维护一份。
# 写法：KEY=VALUE，一行一个；值里有空格或中文时用双引号；不支持 $变量 展开。
# 运行时同名环境变量优先，例如 TASK="..." bash start_collection.sh 会覆盖这里的 TASK。

# ---- conda 环境（留空 = 不激活，直接用当前 python，云服务器上的 venv 就这么用）----
CONDA_ENV=so101_runtime

# ---- 机械臂串口 ----
# 从臂（follower，带夹爪，自己动）
FOLLOWER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B3D047040-if00
FOLLOWER_ID=follower
# 主臂（leader，人手带着动；只有数采机需要）
LEADER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B3D045145-if00
LEADER_ID=leader

# ---- 顶部相机（全流程只用这一路）----
# Orbbec Gemini 335 的 by-id index 每次插拔会乱，必须用 by-path 指到彩色节点（接口 1.4、index0）
# 用 usbv3 写法：误插到 USB2 口时路径不存在，脚本会直接报设备不在位
TOP_CAM=/dev/v4l/by-path/pci-0000:05:00.3-usbv3-0:2.1.1:1.4-video-index0
TOP_CAM_WIDTH=1280
TOP_CAM_HEIGHT=720
TOP_CAM_FPS=30
TOP_CAM_FOURCC=YUYV

# ---- 任务 ----
# 任务文本：数采、训练、推理三处必须逐字一致
TASK="夹起红色糖果，放入黑色笔筒中"
DATASET_ID=local/so101_candy_into_holder
# 控制频率 / 数采帧率
FPS=30

# ---- 模型 ----
# π0.5 只认 base_0_rgb / left_wrist_0_rgb / right_wrist_0_rgb；顶部相机喂给 base_0_rgb，其余两路训练时去掉
# 这一项只给 π0.5 用。SmolVLA 训练时改名为 camera1，由 start_training.sh 的 SMOLVLA_RENAME_MAP 决定
RENAME_MAP=observation.images.top=observation.images.base_0_rgb

# ---- 网页直播 ----
STREAM_PORT=8080
